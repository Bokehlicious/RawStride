{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhotoWorkflow",
  "version": "0.1.0",
  "identifier": "com.photoworkflow.app",
  "build": {
    "frontendDist": "../ui/web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PhotoWorkflow",
        "width": 1600,
        "height": 1000,
        "minWidth": 900,
        "minHeight": 600,
        "maximized": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
