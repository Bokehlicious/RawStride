{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "P2 WebView2",
  "version": "0.0.0",
  "identifier": "com.photoworkflow.proto.p2",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "P2 WebView2",
        "width": 1600,
        "height": 1000,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../../src-tauri/icons/icon.ico"]
  }
}
