# Rust
/target/
# Standalone tool crates with their own [workspace] (e.g. tools/egui-demo)
/tools/*/target/
# Standalone distribution folder (tools/package-dist.ps1)
/dist/
**/*.rs.bk

# vcpkg manifest-mode output
/vcpkg_installed/
# OpenMP measurement variant (docs/libraw-build.md)
/vcpkg_installed_openmp/
/target-openmp/

# Local data – RAW files, catalogs and caches live outside the repo
# (D:\PhotoWorkflowData). Small, licence-clean fixtures only in tests/fixtures.
*.ARW
*.arw
*.dng
*.RW2
*.rw2
# ExifTool backups (written when -overwrite_original is not used)
*_original
# Local test images; real test sets live in D:\PhotoWorkflowData (PW_TESTDATA)
/test_images/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm
/cache/

# Clean-room material must never enter this repository
/pm-clean-room/
*.cany
# Session outputs (e.g. study reports); kept outside the repo
/Claude outputs/

# Editors / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# Profiling
*.etl
*.wpaProfile
*.rdc
/profiling/

# Env
.env
.env.*

# Report written by tools/check.ps1
/test-output.txt
